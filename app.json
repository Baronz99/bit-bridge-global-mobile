{
  "expo": {
    "name": "BitBridge",
    "slug": "bit-bridge-global-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icons/app-icon-1024.png",
    "scheme": "bitbridgeglobal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emmykage.bitbridgeapp",
      "associatedDomains": [
        "applinks:bitbridgeglobal.com",
        "applinks:www.bitbridgeglobal.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BitBridge",
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock BitBridge."
      }
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bitbridgeglobal.com",
              "pathPrefix": "/confirmation"
            },
            {
              "scheme": "https",
              "host": "www.bitbridgeglobal.com",
              "pathPrefix": "/confirmation"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.vortech.bitbridgeapp",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/logos/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/bitbridge-logo-clear.png",
          "imageWidth": 126,
          "resizeMode": "contain",
          "backgroundColor": "#05070D"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-local-authentication",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "./plugins/withBlockSystemAlertWindow"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "138ede9a-6452-46f2-8fe4-0e7c5c30b172"
      }
    },
    "owner": "bz99",
    "updates": {
      "enabled": true,
      "url": "https://u.expo.dev/138ede9a-6452-46f2-8fe4-0e7c5c30b172",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
